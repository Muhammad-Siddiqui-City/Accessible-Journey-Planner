<?xml version="1.0" encoding="utf-8"?>
<!-- Drawable resource for border left red. Centralizes shape/color styling so UI theme updates are easier to maintain. -->

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF0F0" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:left="0dp"
        android:top="0dp"
        android:bottom="0dp"
        android:width="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/destructive" />
            <corners android:topLeftRadius="16dp" android:bottomLeftRadius="16dp" />
        </shape>
    </item>
</layer-list>

