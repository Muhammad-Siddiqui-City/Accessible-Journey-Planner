<!-- National Rail departures list for the selected station. -->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_home_bg">

    <!-- Title + back; station name from fragment arguments. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@android:drawable/ic_menu_revert"
            android:contentDescription="@string/back" />

        <TextView
            android:id="@+id/station_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/ajp_foreground"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="London Waterloo" />
    </LinearLayout>

    <!-- Scroll wraps two RecyclerViews; each section has its own empty TextView. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_station_trains"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tv_arrivals_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/trains_to_station"
                android:textStyle="bold"
                android:textColor="?attr/ajp_foreground"
                android:textSize="16sp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/tv_arrivals_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_upcoming_arrivals"
                android:textColor="?attr/ajp_muted_foreground"
                android:textSize="14sp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/arrivals_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="20dp"
                android:clipToPadding="false"
                tools:listitem="@layout/item_arrival"
                tools:itemCount="3" />

            <TextView
                android:id="@+id/tv_departures_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/trains_from_station"
                android:textStyle="bold"
                android:textColor="?attr/ajp_foreground"
                android:textSize="16sp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp" />

            <TextView
                android:id="@+id/tv_departures_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_departures_available"
                android:textColor="?attr/ajp_muted_foreground"
                android:textSize="14sp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:visibility="gone"
                tools:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/departures_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="20dp"
                android:clipToPadding="false"
                tools:listitem="@layout/item_arrival"
                tools:itemCount="3" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

