<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/card_elevated"
    android:padding="16dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tv_saved_route_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="From → To"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/ajp_foreground" />
        <TextView
            android:id="@+id/tv_saved_route_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saved 2h ago"
            android:textSize="12sp"
            android:textColor="?attr/ajp_muted_foreground" />
    </LinearLayout>
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_media_next"
        android:contentDescription="@null"
        app:tint="?attr/ajp_muted_foreground" />
</LinearLayout>
