<?xml version="1.0" encoding="utf-8"?>
<!-- AI Generated -->
<!-- Lovable.dev: UI mockup reference -->
<!-- Built with Claude -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_home_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Header: back, title, share, bookmark -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="12dp">
            <ImageButton
                android:id="@+id/back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/glass_card"
                app:srcCompat="@android:drawable/ic_menu_revert"
                android:contentDescription="Back" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/route_details"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/ajp_foreground"
                android:gravity="center"
                android:layout_marginHorizontal="8dp" />
            <ImageButton
                android:id="@+id/save"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/glass_card"
                app:srcCompat="@android:drawable/ic_menu_save"
                android:contentDescription="@string/save" />
            <ImageButton
                android:id="@+id/share"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/glass_card"
                app:srcCompat="@android:drawable/ic_menu_share"
                android:contentDescription="Share" />
        </LinearLayout>

        <!-- Summary card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/glass_card"
            android:padding="20dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/from_label" android:textSize="10sp" android:textColor="?attr/ajp_muted_foreground" />
                <TextView android:id="@+id/tv_from" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/kings_cross" android:textSize="14sp" android:textStyle="bold" android:textColor="?attr/ajp_foreground" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/to_label" android:textSize="10sp" android:textColor="?attr/ajp_muted_foreground" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/tv_to" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/green_park" android:textSize="14sp" android:textStyle="bold" android:textColor="?attr/ajp_foreground" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="?attr/ajp_foreground" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/minutes"
                    android:textSize="16sp"
                    android:textColor="?attr/ajp_muted_foreground"
                    android:layout_marginStart="4dp" />
                <View android:layout_width="1dp" android:layout_height="40dp" android:background="?attr/ajp_border" android:layout_marginHorizontal="16dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="end">
                    <TextView android:id="@+id/tv_depart_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14:32" android:textSize="20sp" android:textStyle="bold" android:textColor="?attr/ajp_foreground" />
                    <TextView android:id="@+id/tv_arrival_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="→ 14:47" android:textSize="14sp" android:textColor="?attr/ajp_muted_foreground" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Step-free route" android:textSize="12sp" android:textStyle="bold" android:background="#E0F7F4" android:textColor="@color/secondary" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:layout_marginEnd="8dp" />
                <TextView android:id="@+id/badge_cached_offline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cached_offline" android:textSize="12sp" android:textStyle="bold" android:background="#E8F0FE" android:textColor="@color/primary" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:layout_marginEnd="8dp" android:visibility="gone" />
                <TextView android:id="@+id/tv_transfers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 transfers" android:textSize="12sp" android:textColor="?attr/ajp_muted_foreground" android:paddingVertical="6dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/tv_lift_disruption_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lift_disruption_warning"
                android:textSize="12sp"
                android:textColor="#D32F2F"
                android:visibility="gone"
                android:maxLines="4"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/tv_crowding_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/crowding_warning"
                android:textSize="12sp"
                android:textColor="#D32F2F"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Start Journey button (logs to analytics) -->
        <Button
            android:id="@+id/start_navigation"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_teal_gradient"
            android:text="@string/start_navigation"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- GPS-based progress (shown when navigation started) -->
        <LinearLayout
            android:id="@+id/layout_live_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@drawable/glass_card"
            android:padding="16dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:id="@+id/tv_journey_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/navigating"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="?attr/ajp_foreground" />
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_bar_journey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0"
                app:indicatorColor="@color/design_default_color_primary"
                app:trackColor="#E0E0E0"
                app:trackCornerRadius="4dp" />
            <TextView
                android:id="@+id/tv_progress_percent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0%"
                android:gravity="end"
                android:layout_marginTop="4dp"
                android:textColor="?attr/ajp_muted_foreground" />
        </LinearLayout>

        <!-- Step by step -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step_by_step"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="12dp" />
        <TextView
            android:id="@+id/tv_poi_verification_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="12dp"
            android:textColor="@color/warning"
            android:textSize="14sp"
            android:visibility="gone"
            android:importantForAccessibility="yes" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/steps_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
